# TML 接口认证（可选）。留空时从 users.json 默认账号读取（推荐经飞书「登录」自助获取）。
# 填写则优先使用，向后兼容旧抓包配置。
TML_USER_ID=
TML_LOGIN_SESSION=

# 飞书自建应用（必填）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 接收人 ID（必填）。默认使用 open_id，例如 ou_xxx。
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=open_id

# @机器人即时触发白名单，多个 ID 用英文逗号分隔，命中任意一项即可。
# 未填写时：receive_id_type=chat_id 会默认允许 FEISHU_RECEIVE_ID 对应群聊；
# receive_id_type=open_id/user_id/union_id 会默认允许 FEISHU_RECEIVE_ID 对应用户。
FEISHU_TRIGGER_CHAT_IDS=
FEISHU_TRIGGER_SENDER_IDS=

# 支持“@机器人”、“@机器人 二维码”和“@机器人 重发二维码”。
FEISHU_TRIGGER_COMMANDS=二维码,重发二维码
FEISHU_TRIGGER_ALLOW_BARE_MENTION=true

# 飞书内登录与账号管理（私聊或授权群聊发起）。
# 关闭则机器人不再响应 登录/验证码/账号/切换/取消登录 命令。
FEISHU_LOGIN_INTERACTION_ENABLED=true
# 是否允许直接回复 6 位数字作为验证码（关闭则必须用「验证码 xxx」格式）。
FEISHU_LOGIN_BARE_CODE_ENABLED=true
# 登录会话有效期（毫秒），超时需重新发送验证码。
FEISHU_LOGIN_SESSION_TTL_MS=60000
# 覆盖 users.json 路径（默认项目根 users.json，600 权限，已被 .gitignore 忽略）。
# TML_USERS_FILE=

# TML 接口参数
TML_GLOBAL_AREA_ID=1
TML_AREA_ID=1
TML_PARK_ID=1
TML_BALANCE_API_URL=https://isp.tml-itcity.com/ipark-mobile/bookkeepingRechargebalanceBalance/paginQuery

# 抓包时才需要；正常运行通常留空。
TML_HTTP_PROXY=

# 可选设置
REQUEST_TIMEOUT_MS=20000
FEISHU_FAILURE_NOTIFICATION=true

# 即时触发任务先安全落盘，失败后重试；通常无需修改。
FEISHU_TRIGGER_MAX_ATTEMPTS=3
FEISHU_TRIGGER_RETRY_DELAY_MS=15000
FEISHU_TRIGGER_COOLDOWN_MS=10000
FEISHU_TRIGGER_QUEUE_DIR=.runtime/feishu-trigger-queue
FEISHU_TRIGGER_HISTORY_RETENTION_MS=604800000

# 定时任务与即时触发共用发送锁，避免并发请求；通常无需修改。
QR_SEND_LOCK_PATH=.runtime/qr-send.lock
QR_SEND_LOCK_TIMEOUT_MS=75000
QR_SEND_LOCK_STALE_MS=180000

# 默认二维码只存在于安全临时目录，发送后立即删除。
# 调试时可设为 true，并保存到 QR_OUTPUT_PATH。
KEEP_QR=false
QR_OUTPUT_PATH=consume-qr.png
