# TML 接口认证（必填）
TML_USER_ID=
TML_LOGIN_SESSION=

# 飞书自建应用（必填）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 接收人 ID（必填）。默认使用 open_id，例如 ou_xxx。
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=open_id

# TML 接口参数
TML_GLOBAL_AREA_ID=1
TML_AREA_ID=1
TML_PARK_ID=1

# 抓包时才需要；正常运行通常留空。
TML_HTTP_PROXY=

# 可选设置
REQUEST_TIMEOUT_MS=20000
FEISHU_FAILURE_NOTIFICATION=true

# 默认二维码只存在于安全临时目录，发送后立即删除。
# 调试时可设为 true，并保存到 QR_OUTPUT_PATH。
KEEP_QR=false
QR_OUTPUT_PATH=consume-qr.png

